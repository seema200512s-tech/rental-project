# RentRide Environment Configuration Template
SECRET_KEY=super-secret-rentride-key-2026
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=rentride
MYSQL_PORT=3306
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://rental-project-tan.vercel.app

# Razorpay Payment Gateway (Test Mode / Live Mode)
# Obtain test credentials from Razorpay Dashboard: Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_KEY_SECRET
# Obtain webhook secret from Razorpay Dashboard: Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_YOUR_WEBHOOK_SECRET
